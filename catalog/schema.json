{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "catalog_version": {"type": "string"},
    "source": {"type": "string"},
    "source_of_truth": {"type": "string"},
    "generation_note": {"type": "string"},
    "status_vocabulary": {
      "type": "object",
      "properties": {
        "spec_status": {
          "type": "array",
          "items": {"type": "string"}
        },
        "verification_status": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "named_revision_2_constraints": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["catalog_ids"],
        "properties": {
          "catalog_ids": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["label","owner_constraint"],
        "properties": {
          "label": {"type": "string"},
          "owner_constraint": {"type": "string"},
          "value_defined": {"type": "boolean"},
          "status": {"type": "string"},
          "owner_phase": {"type": "string"},
          "note": {"type": "string"},
          "value": {"type": "string"}
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","constraint","owner_phase","test_id","spec_status","verification_status"],
        "properties": {
          "id": {"type": "string"},
          "constraint": {"type": "string"},
          "owner_phase": {
            "type": ["array","string"]
          },
          "test_id": {"type": "string"},
          "verification_evidence": {"type": "string"},
          "spec_status": {"type": "string"},
          "verification_status": {"type": "string"},
          "value_defined": {"type": "boolean"},
          "provenance": {
            "type": "array",
            "items": {"type": "string"}
          },
          "named_constraints": {
            "type": "array",
            "items": {"type": "string"}
          },
          "supersedes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "amends": {
            "type": "array",
            "items": {"type": "string"}
          },
          "depends_on": {
            "type": "array",
            "items": {"type": "string"}
          },
          "value_notes": {"type": "string"},
          "value": {"type": "string"},
          "tunable_values": {
            "type": "array",
            "items": {"type": "string"}
          },
          "phase_8_scope_status": {"type": "string"},
          "verification": {"type": "string"}
        }
      }
    },
    "ci_lint_rules": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
