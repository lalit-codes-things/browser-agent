{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Browser Agent",
  "version": "0.1.0",
  "identifier": "com.browseragent.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm --filter frontend dev",
    "beforeBuildCommand": "pnpm --filter frontend build",
    "devtools": true,
    "beforeDevCommandMSI": false,
    "beforeBuildCommandMSI": false
  },
  "app": {
    "windows": [
      {
        "title": "Browser Agent",
        "label": "main",
        "width": 1280,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": {
      "image": "icons/icon.png"
    },
    "resources": [],
    "windows": {
      "wix": null,
      "nsis": {
        "license": null,
        "installerIcon": null
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
